{
  "Version": "hv-1",
  "Statement": [
    {
      "Sid": "OpsHuman",
      "Effect": "Allow",
      "Action": ["secret:*", "target:*", "approval:Grant", "policy:Get", "policy:Simulate", "audit:Read", "sys:*"],
      "Resource": "hv:*",
      "Condition": {
        "NumericLessThanEquals": {"hv:MfaAgeSeconds": 900},
        "StringEquals": {"hv:SourceChannel": "tunnel"}
      }
    }
  ]
}
